# Copy to .env (never commit it) and fill in what you need.

# Required. A long random string used to sign login sessions.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# --- Database ---
# With Docker Compose a PostgreSQL database is started for you; only choose its password here.
POSTGRES_PASSWORD=

# Running the app yourself (or on a host like Railway)? Set DATABASE_URL to use PostgreSQL:
#   DATABASE_URL=postgres://user:password@host:5432/dbname
# Leave it unset to use a SQLite file instead (DB_FILE, default tasks.db).
# Hosted databases often need TLS: append ?sslmode=require to the URL. If the host's certificate can't be verified,
# PG_SSL=no-verify keeps the connection encrypted but skips the certificate check.
DATABASE_URL=
# DB_FILE=tasks.db
# PG_SSL=no-verify

# Leave true when served over HTTPS. Use false only for plain-HTTP setups such as a home network.
COOKIE_SECURE=true

# --- Optional: AI helpers (subtask suggestions, "Plan my day") ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# --- Optional: Google Calendar and Gmail ---
# Create an OAuth client at console.cloud.google.com and add this redirect URI:
#   <PUBLIC_URL>/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The address people use to reach the app, e.g. https://tasks.example.com
PUBLIC_URL=
# Required with Google in production. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=
